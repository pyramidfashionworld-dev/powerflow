# Google Sheets Integration Configuration
# 
# SETUP INSTRUCTIONS:
# 1. Create a Google Sheet with your consumer data
# 2. Go to: https://console.cloud.google.com/
# 3. Create a new project
# 4. Enable Google Sheets API
# 5. Create an API key
# 6. Share your Google Sheet publicly (or configure service account)
# 7. Get the Sheet ID from URL: https://docs.google.com/spreadsheets/d/{SHEET_ID}/edit
# 8. Add the values below:

# Your Google Sheet ID (from URL)
VITE_GOOGLE_SHEET_ID=your-spreadsheet-id-here

# Google API Key (from Google Cloud Console)
# Get it from: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_API_KEY=your-api-key-here

# Optional: Sheet name if not "Sheet1"
VITE_SHEET_NAME=Sheet1

# Enable/disable Google Sheets integration
VITE_USE_GOOGLE_SHEETS=true
